---
import Base from '../layouts/Base.astro';
import { sourceList } from '../data/sources';
import { glossaryList } from '../data/glossary';
import { QUESTIONS } from '../data/questions';
import { FACTS } from '../data/facts';
import { fr } from '../lib/format';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const sources = sourceList();
const usage = new Map<string, string[]>();
for (const q of QUESTIONS) for (const s of q.sources) usage.set(s.id, [...(usage.get(s.id) ?? []), q.id]);
for (const f of FACTS) if (!usage.has(f.sourceId)) usage.set(f.sourceId, ['chiffres chocs']);

const kindLabel: Record<string, string> = { officiel: 'Source officielle', rapport: 'Rapport', éditeur: 'Publié par l’éditeur', presse: 'Presse', norme: 'Norme / référence' };
const domainLabel: Record<string, string> = { cyber: 'Cybersécurité', management: 'Management & gouvernance', ia: 'Intelligence artificielle', institution: 'Institutions', crypto: 'Cryptographie' };
const glossary = glossaryList();
const domains = ['management', 'cyber', 'ia', 'crypto', 'institution'];

const notes = [
  "Chiffres vérifiés dans leurs sources primaires le 16 octobre 2026.",
  "ENISA : administration publique = 31,8 % des incidents recensés (2025).",
  "ANCS : le chiffre de 336 avis de sécurité (366 dans le graphique mensuel) n'est pas utilisé.",
  "Jaguar Land Rover : impact économique estimé par le CMC, pas des pertes auditées.",
  "IA : chiffres publiés par Anthropic ou ses partenaires, sans audit indépendant.",
  "Glasswing : +10 000 failles = mise à jour du 22 mai 2026 ; 129 000 vérifiées = mise à jour d'octobre 2026.",
  "Le schéma « management de demain » est un cadre pédagogique, pas une prévision.",
];
---

<Base title="EUREKA26 — Sources, méthodologie et glossaire" description="Sources primaires, méthodologie de vérification, fonctionnement sans serveur et glossaire des abréviations de l'expérience EUREKA26.">
  <div class="mx-auto max-w-5xl px-4 pb-20 pt-6 md:px-6">
    <header class="flex flex-wrap items-center justify-between gap-4">
      <a href={base} class="flex items-center gap-3" aria-label="Retour au questionnaire">
        <img src={`${base}favicon.svg`} alt="" width="36" height="36" />
        <span class="font-display text-2xl font-bold">EUREKA<span class="text-cyan-300">26</span></span>
      </a>
      <nav class="flex flex-wrap gap-2 text-sm" aria-label="Navigation">
        <a class="chip hover:text-ink" href="#methodologie">Méthodologie</a>
        <a class="chip hover:text-ink" href="#sources">Sources</a>
        <a class="chip hover:text-ink" href="#glossaire">Glossaire</a>
      </nav>
    </header>

    <section class="mt-10">
      <h1 class="font-display text-4xl font-bold tracking-tight md:text-5xl">Sources, méthodologie et glossaire</h1>
      <p class="mt-4 inline-block rounded-xl border border-amber-400/40 bg-amber-400/10 px-3 py-1.5 text-sm text-amber-100">⚠︎ Contient les réponses</p>
    </section>

    <section id="methodologie" class="mt-12 scroll-mt-6">
      <h2 class="font-display text-3xl font-bold">Méthodologie</h2>
      <ul class="mt-4 list-disc space-y-1.5 pl-5 text-ink-2">
        {notes.map((n) => (
          <li>{fr(n)}</li>
        ))}
      </ul>
    </section>

    <section id="sources" class="mt-12 scroll-mt-6">
      <h2 class="font-display text-3xl font-bold">Sources</h2>
      <ul class="mt-4 grid gap-3">
        {sources.map((s) => (
          <li class="glass rounded-2xl p-4" id={`src-${s.id}`}>
            <div class="flex flex-wrap items-center gap-2 text-xs">
              <span class="chip">{kindLabel[s.kind]}</span>
              <span class="text-ink-3">Publié : {s.date} · vérifié le {s.verifiedOn}</span>
              {usage.get(s.id) && <span class="text-ink-3">· utilisé pour : {usage.get(s.id)!.join(', ')}</span>}
            </div>
            <p class="mt-2 font-semibold text-ink">{s.publisher}</p>
            <a class="mt-0.5 block break-words text-cyan-300 underline decoration-dotted underline-offset-4 hover:text-cyan-200" href={s.url} rel="noopener noreferrer" target="_blank">{fr(s.title)}</a>
          </li>
        ))}
      </ul>
    </section>

    <section id="glossaire" class="mt-12 scroll-mt-6">
      <h2 class="font-display text-3xl font-bold">Glossaire</h2>
      {domains.map((d) => (
        <div class="mt-6">
          <h3 class="text-sm font-semibold uppercase tracking-[0.18em] text-ink-3">{domainLabel[d]}</h3>
          <dl class="mt-2 grid gap-3 md:grid-cols-2">
            {glossary.filter((g) => g.domain === d).map((g) => (
              <div class="glass rounded-2xl p-4" id={`term-${g.term.replace(/[^A-Za-z0-9]+/g, '-')}`}>
                <dt>
                  <span class="font-display text-xl font-bold text-ink">{g.term}</span>
                  <span class="ml-2 text-sm text-cyan-200">{g.expansion}</span>
                </dt>
                <dd class="mt-1 text-sm leading-relaxed text-ink-2">{fr(g.definition)}</dd>
              </div>
            ))}
          </dl>
        </div>
      ))}
    </section>

    <footer class="mt-14 flex flex-wrap gap-3 border-t border-edge pt-6 text-sm text-ink-3">
      <a class="btn btn-primary" href={base}>Faire le questionnaire</a>
      <a class="btn btn-ghost" href={`${base}results/`}>Écran de résultats</a>
    </footer>
  </div>
</Base>
