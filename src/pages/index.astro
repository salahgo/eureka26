---
import Base from '../layouts/Base.astro';
import QuizApp from '../components/quiz/QuizApp.tsx';
---

<Base title="EUREKA26 — Connaissez-vous vraiment les chiffres ?">
  <QuizApp client:only="react">
    <div slot="fallback" class="flex min-h-dvh items-center justify-center px-6 text-center">
      <div>
        <p class="font-display text-5xl font-bold tracking-tight">EUREKA<span class="text-cyan-300">26</span></p>
        <p class="mt-3 text-ink-2">Chargement du questionnaire…</p>
        <noscript><p class="mt-4 text-amber-300">Ce questionnaire nécessite JavaScript.</p></noscript>
      </div>
    </div>
  </QuizApp>
</Base>
