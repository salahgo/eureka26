{
  "name": "eureka26",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "EUREKA26 — Cybersécurité, IA & Management : connaissez-vous la réalité ? Expérience interactive de conférence, 100 % statique (GitHub Pages).",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "typecheck": "astro sync && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --project=screenshots",
    "ci": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@astrojs/react": "7.1.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.0",
    "jsqr": "1.4.0",
    "lucide-react": "1.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
